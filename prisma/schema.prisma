generator client {
  provider      = "prisma-client-js"
  output        = "../server/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ContributionStatus {
  PENDING
  PARTIAL
  PAID
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum TxnFlow {
  INCOME
  EXPENSE
}

enum TxnCategory {
  SAVING_DEPOSIT
  SAVING_WITHDRAWAL
  INTEREST
  PROFIT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  EXPENSE
  ZAKAT
}

model Member {
  id             String   @id @default(cuid())
  memberCode     String   @unique
  name           String
  mobile         String
  address        String?
  passwordHash   String
  role           Role     @default(MEMBER)
  isSavingMember Boolean  @default(false)
  isLoanMember   Boolean  @default(false)
  joinDate       DateTime @default(now())
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  monthlyAmounts MonthlyAmountHistory[]
  contributions  MonthlyContribution[]
  loans          Loan[]
  transactions   Transaction[]
  channelLinks   ChannelLink[]
  linkCodes      ChannelLinkCode[]

  @@index([mobile])
}

model MonthlyAmountHistory {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year     Int
  amount   Decimal @db.Decimal(12, 2)

  @@unique([memberId, year])
}

model MonthlyContribution {
  id         String             @id @default(cuid())
  memberId   String
  member     Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  amountDue  Decimal            @db.Decimal(12, 2)
  amountPaid Decimal            @default(0) @db.Decimal(12, 2)
  status     ContributionStatus @default(PENDING)
  paidDate   DateTime?

  @@unique([memberId, year, month])
}

model Bank {
  id                    String    @id @default(cuid())
  name                  String
  accountHolderName     String?
  accountNumber         String?
  branchName            String?
  branchSolId           String?
  customerId            String?
  accountOpenDate       DateTime?
  modeOfOperation       String?
  jointHolders          String?
  ifscCode              String?
  micrCode              String?
  swiftCode             String?
  currency              String    @default("INR")
  nominationRegistered  Boolean?
  openingBalance        Decimal   @default(0) @db.Decimal(14, 2)
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())

  transactions Transaction[]
}

model Loan {
  id             String     @id @default(cuid())
  memberId       String
  member         Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  principalAmount Decimal   @db.Decimal(12, 2)
  disbursedDate  DateTime
  status         LoanStatus @default(ACTIVE)
  balance        Decimal    @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())

  transactions Transaction[]
}

model Transaction {
  id             String      @id @default(cuid())
  memberId       String?
  member         Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  bankId         String?
  bank           Bank?       @relation(fields: [bankId], references: [id])
  date           DateTime
  description    String
  flow           TxnFlow
  category       TxnCategory
  amount         Decimal     @db.Decimal(12, 2)
  linkedLoanId   String?
  linkedLoan     Loan?       @relation(fields: [linkedLoanId], references: [id])
  profitBatchId  String?
  createdBy      String
  createdAt      DateTime    @default(now())

  @@index([memberId])
  @@index([bankId])
  @@index([category])
  @@index([profitBatchId])
}

// --- The AI assistant (server/src/ai/) ---

// Small app-wide settings, by key - the assistant's daily limits
// ("assistant.daily_limit.member", set on the Settings page).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Questions asked per person per day (the KMCC day, see ai/time.ts), for the
// daily limits. userKey: the member id; a Telegram guest "tg:<telegram id>".
model AssistantUsage {
  userKey String
  day     String
  count   Int    @default(0)

  @@id([userKey, day])
}

// A chat account (Telegram now, WhatsApp later) linked to a KMCC login.
model ChannelLink {
  channel     String
  externalId  String
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  displayName String?
  createdAt   DateTime @default(now())

  @@id([channel, externalId])
  @@index([memberId])
}

// One-time codes for linking a chat account from the app (10 minutes; only
// the hash is kept).
model ChannelLinkCode {
  codeHash  String   @id
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

// A chat account's preferences, linked or not (the voice-note language).
model ChannelPref {
  channel       String
  externalId    String
  voiceLanguage String

  @@id([channel, externalId])
}

// Telegram update ids already handled: Telegram may send one twice.
model TelegramUpdate {
  updateId   BigInt   @id
  receivedAt DateTime @default(now())
}
